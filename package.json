{
  "name": "superfaktura-library",
  "version": "1.0.3",
  "description": "Simple SuperFaktura SDK and CLI for contacts and invoices.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "prepublishOnly": "pnpm run build"
  },
  "bin": {
    "superfaktura": "./bin/superfaktura.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "keywords": [
    "superfaktura",
    "invoices",
    "contacts",
    "cli",
    "sdk"
  ],
  "author": "Martin Jakubík <martindzejky@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "dependencies": {
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.12",
    "@types/node": "^26.1.2",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3"
  }
}
